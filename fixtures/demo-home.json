  "rules": [
    {
      "id": "R1",
      "text": "Never turn off the garage freezer.",
      "author": "om",
      "priority": "device-protection",
      "template": "always",
      "params": {
        "state": {
          "device": "plug_garage_freezer",
          "attr": "onOff",
          "eq": true
        }
      },
      "source": "IoTGuard R.14"
    },
    {
      "id": "R2",
      "text": "Keep the aquarium heater on.",
      "author": "maya",
      "priority": "device-protection",
      "template": "always",
      "params": {
        "state": {
          "device": "plug_aquarium",
          "attr": "onOff",
          "eq": true
        }
      },
      "source": "IoTGuard R.14 (adapted)"
    },
    {
      "id": "R3",
      "text": "Don't let the garage pipes freeze.",
      "author": "om",
      "priority": "device-protection",
      "template": "keep_between",
      "params": {
        "quantity": {
          "zone": "garage",
          "attr": "temperatureC"
        },
        "min": 4,
        "max": null,
        "when": null
      },
      "source": "IotSan temperature properties; IoTSafe"
    },
    {
      "id": "R4",
      "text": "Front door locked when nobody's home.",
      "author": "om",
      "priority": "security",
      "template": "never_when",
      "params": {
        "x": {
          "device": "front_door_lock",
          "attr": "lockState",
          "eq": "UNLOCKED"
        },
        "when": {
          "presence": "nobody"
        }
      },
      "source": "IoTGuard R.1; Soteria P.1"
    },
    {
      "id": "R5",
      "text": "Back door locked when nobody's home.",
      "author": "om",
      "priority": "security",
      "template": "never_when",
      "params": {
        "x": {
          "device": "back_door_lock",
          "attr": "lockState",
          "eq": "UNLOCKED"
        },
        "when": {
          "presence": "nobody"
        }
      },
      "source": "IoTGuard R.1"
    },
    {
      "id": "R6",
      "text": "When there's smoke, turn the lights on and unlock the front door.",
      "author": "maya",
      "priority": "life-safety",
      "template": "within_after",
      "params": {
        "minutes": 1,
        "after": {
          "device": "smoke_alarm_kitchen",
          "attr": "smokeState",
          "neq": "normal"
        },
        "ensure": [
          {
            "device": "light_living",
            "attr": "onOff",
            "eq": true
          },
          {
            "device": "light_kitchen",
            "attr": "onOff",
            "eq": true
          },
          {
            "device": "front_door_lock",
            "attr": "lockState",
            "eq": "UNLOCKED"
          }
        ]
      },
      "source": "IoTGuard R.3"
    },
    {
      "id": "R7",
      "text": "Space heater off when nobody's home.",
      "author": "maya",
      "priority": "life-safety",
      "template": "never_when",
      "params": {
        "x": {
          "device": "plug_bedroom_space_heater",
          "attr": "onOff",
          "eq": true
        },
        "when": {
          "presence": "nobody"
        }
      },
      "source": "IoTGuard R.13"
    },
    {
      "id": "R8",
      "text": "No coffee maker running when nobody's home.",
      "author": "om",
      "priority": "life-safety",
      "template": "never_when",
      "params": {
        "x": {
          "device": "plug_coffee_maker",
          "attr": "onOff",
          "eq": true
        },
        "when": {
          "presence": "nobody"
        }
      },
      "source": "IoTGuard R.13"
    },
    {
      "id": "R9",
      "text": "Don't run the bedroom heater with the window open.",
      "author": "maya",
      "priority": "comfort",
      "template": "never_together",
      "params": {
        "a": {
          "device": "plug_bedroom_space_heater",
          "attr": "onOff",
          "eq": true
        },
        "b": {
          "device": "window_bedroom_main",
          "attr": "contact",
          "eq": "open"
        }
      },
      "source": "IoTGuard R.24"
    },
    {
      "id": "R10",
      "text": "Indoor lights off when nobody's home.",
      "author": "maya",
      "priority": "comfort",
      "template": "never_when",
      "params": {
        "x": {
          "any": [
            {
              "device": "light_living",
              "attr": "onOff",
              "eq": true
            },
            {
              "device": "light_kitchen",
              "attr": "onOff",
              "eq": true
            },
            {
              "device": "light_bedroom_main",
              "attr": "onOff",
              "eq": true
            },
            {
              "device": "light_bedroom_sam",
              "attr": "onOff",
              "eq": true
            }
          ]
        },
        "when": {
          "presence": "nobody"
        }
      },
      "source": "Soteria P.12"
    },
    {
      "id": "R11",
      "text": "Don't run the dishwasher unless its door is latched.",
      "author": "om",
      "priority": "device-protection",
      "template": "never_when",
      "params": {
        "x": {
          "device": "dishwasher",
          "attr": "onOff",
          "eq": true
        },
        "when": {
          "device": "dishwasher_latch",
          "attr": "contact",
