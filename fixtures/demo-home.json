  "routines": [
    {
      "id": "good_night",
      "name": "Good night",
      "owner": "maya",
      "enabled": true,
      "trigger": {
        "type": "time",
        "at": "22:30",
        "days": "daily"
      },
      "actions": [
        {
          "device": "front_door_lock",
          "set": {
            "lockState": "LOCKED"
          }
        },
        {
          "device": "back_door_lock",
          "set": {
            "lockState": "LOCKED"
          }
        },
        {
          "group": "indoor_lights",
          "set": {
            "onOff": false
          }
        }
      ]
    },
    {
      "id": "coffee_at_7",
      "name": "Coffee at 7",
      "owner": "om",
      "enabled": true,
      "trigger": {
        "type": "time",
        "at": "07:00",
        "days": "daily"
      },
      "actions": [
        {
          "device": "plug_coffee_maker",
          "set": {
            "onOff": true
          }
        },
        {
          "device": "plug_coffee_maker",
          "set": {
            "onOff": false
          },
          "afterMinutes": 30
        }
      ]
    },
    {
      "id": "porch_light",
